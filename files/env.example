# ── Персона ───────────────────────────────────────────────
ASSISTANT_NAME=Веселовская
# ASSISTANT_TONE=дружелюбно, по делу, без канцелярита

# ── Бесплатная текстовая модель ──────────────────────────
# Достаточно одного ключа с бесплатного тарифа — карта не нужна.
# Подхватывается автоматически, порядок: OpenRouter → Groq → Gemini →
# Mistral → Cerebras → локальная Ollama. Список и статус: python3 -m veselovskaya providers
# OPENROUTER_API_KEY=      # https://openrouter.ai/keys        ~50 запросов/день
# GROQ_API_KEY=            # https://console.groq.com/keys     быстрый и щедрый
# GEMINI_API_KEY=          # https://aistudio.google.com/apikey
# MISTRAL_API_KEY=         # https://console.mistral.ai/api-keys
# CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
# VESELOVSKAYA_PROVIDER=groq    # зафиксировать провайдера
# VESELOVSKAYA_FREE=0           # отключить автоподбор бесплатных
# LLM_MODEL=                    # своя модель, например qwen/qwen3-235b-a22b:free

# ── Своя модель (любой OpenAI-совместимый API) ───────────
# Если задан LLM_BASE_URL — бесплатный автоподбор не вмешивается.
# OpenAI, DeepSeek, Together, локальный Ollama/vLLM.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=90

# Примеры альтернатив:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# ── Генерация изображений (OpenAI-совместимый /images/generations)
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024

# ── Файлы ─────────────────────────────────────────────────
ARTIFACTS_DIR=./artifacts

# ── Сервер и Telegram ─────────────────────────────────────
HOST=0.0.0.0
PORT=8000
TELEGRAM_BOT_TOKEN=
